	<munit:test name="getWeather-success-test" doc:id="6b45261a-c207-4167-92be-bf74e5563cbe" description="Test caching strategy">
		<munit:behavior >
			<munit-tools:mock-when doc:name="GET /weather" doc:id="04456bfc-3504-4b7e-9f9f-77168bfe2da8" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="openWeather" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="OpenWeather_Request_Config" attributeName="config-ref" />
					<munit-tools:with-attribute whereValue="/weather" attributeName="path" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[output application/java --- readUrl('classpath://mocks/mock-openWeather-kyiv-success.json', 'application/json')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<os:clear doc:name="Clear" doc:id="6456ba86-7435-4dc5-8bdf-c16cc0468bb4" objectStore="weather-cache-store"/>
			<munit:set-event doc:name="Set Event" doc:id="42fdcb1e-71e0-45e1-946f-2e97078b011e" >
				<munit:attributes value='#[{queryParams: {city: "Kyiv"}}]' />
			</munit:set-event>
			<flow-ref doc:name="getWeather_cacheMiss" doc:id="cc6a5793-2c2a-4289-baa2-ace910fdd208" name="getWeather"/>
			<munit:set-event doc:name="Set Event" doc:id="bc31905f-ee42-4253-ac78-deb7d5c634ab">
			<munit:attributes value='#[{queryParams: {city: "Kyiv"}}]' />
		</munit:set-event>
			<flow-ref doc:name="getWeather_cacheHit" doc:id="cf0183d0-cdf4-4be4-8596-3365fb679cff" name="getWeather" />
		</munit:execution>
		<munit:validation >
			<munit-tools:verify-call doc:name="GET /weather" doc:id="f6bde939-d8a4-4067-b6eb-34993a3d5872" processor="http:request" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="openWeather" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="OpenWeather_Request_Config" attributeName="config-ref" />
					<munit-tools:with-attribute whereValue="/weather" attributeName="path" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
