<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="is-flights-system-implementation-test-suite.xml" />
	<munit:test name="getFlightById-success-test" doc:id="37c47fef-6738-48b6-a8d3-a678e6bb6b90" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="4006b435-7ccf-442d-83e1-f31801bd2bc0" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Select flight" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="51772ea4-5009-4f9d-862a-b64df44d24fd" attributeName="doc:id" />
					<munit-tools:with-attribute whereValue="Database_Config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[readUrl('classpath://mocks/mock-db-select-flight-success.json', 'application/json')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="8af75fb6-64eb-45ef-a133-771a595ff060" >
				<munit:attributes value='#[{ queryParams: {"flightId": 3}}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to getFlightById" doc:id="d10a5ed5-2a28-4293-aa7b-290ad10a309f" name="getFlightById"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="af7ec481-3f42-4be7-a163-d34bbe3e189f" actual="#[payload]" expected="#[readUrl('classpath://asserts/assert-payload-flight-success.json', 'application/json')]"/>
		</munit:validation>
	</munit:test>


</mule>
