#%RAML 1.0
title: Flights System API
version: v1

types:
  Flight: !include datatypes/Flight.raml

/flights:

  get:
    queryParameters:
      destination?:
        type: string
        enum: ["SFO", "LAX", "CLE"]
        displayName: Flight Destination
        description: IATA code of the airport where the flight is scheduled to arrive.
        example: "LAX"

    responses:
      200:
        body:
          application/json:
            type: Flight[]
            example: !include examples/flights-example.json

  /{flightId}:
    get:
      responses:
        200:
          body:
            application/json:
              type: Flight
              example: !include examples/flight-example.json


/countries:
  get:
    description: Retrieve a list of countries and info about capitals
    queryParameters:
      codes:
        description: Code(s) of the  country(ies) to filter by
        required: true
        type: string
        example: "ua,pl"

    responses:
      200:
        body:
          application/json:
            example: !include examples/countries-example.json

/weather:
  get:
    description: Retrieve weather information for city
    queryParameters:
      city:
        description: Name of the city to get weather for
        required: true
        type: string
        example: "Kyiv"
    responses:
      200:
        body:
          application/json:
            example: !include examples/weather-example.json

