<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:batch="http://www.mulesoft.org/schema/mule/batch" xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:american-flights-api="http://www.mulesoft.org/schema/mule/american-flights-api" xmlns:db="http://www.mulesoft.org/schema/mule/db" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/american-flights-api http://www.mulesoft.org/schema/mule/american-flights-api/current/mule-american-flights-api.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
http://www.mulesoft.org/schema/mule/batch http://www.mulesoft.org/schema/mule/batch/current/mule-batch.xsd">

	<http:request-config name="OpenWeather_Request_Config" doc:name="HTTP Request config" doc:id="5728dca8-6ec9-4be0-8421-2866f66e3976" basePath="/data/2.5" >
		<http:request-connection protocol="HTTPS" host="api.openweathermap.org" />
		<http:default-query-params >
			<http:query-param key="appid" value="87296d5a25619dbc0f2d13b664bcc0ea" />
			<http:query-param key="units" value="metric" />
		</http:default-query-params>
	</http:request-config>
	<sub-flow name="getFlights" doc:id="abdaf767-c6fd-4821-a672-452a584a0fb0" >
		<set-variable value="#[message.attributes.queryParams.destination]" doc:name="destination" doc:id="e639483f-d9cb-4a46-8eba-b4f3ee4eac66" variableName="destination" />
		<set-variable value='#[{ "status": "Get American Flights request"}]' doc:name="logMessage" doc:id="de8b3680-7d20-41d8-9a1f-56fcc67fc8be" variableName="logMessage" />
		<flow-ref doc:name="logAudit" doc:id="9c570a10-1f71-4cdb-b948-07ca140ab36f" name="logAudit" />
		<db:select doc:name="Select flights" doc:id="e6ee4a8f-dc34-409f-8cb1-a2cd77ad21fa" config-ref="Database_Config" >
			<db:sql ><![CDATA[SELECT * FROM flights
WHERE (:destination IS NULL OR toAirport = :destination)
]]></db:sql>
			<db:input-parameters ><![CDATA[#[{ destination: vars.destination}]]]></db:input-parameters>
		</db:select>
		<set-variable value='#[{ "status": "Get flights from DB",&#10;	"fetchedRecords": sizeOf(payload)&#10;}]' doc:name="logMessage" doc:id="416bb672-c274-41aa-935e-9234925a14aa" variableName="logMessage" />
		<ee:transform doc:name="Transform Message" doc:id="a85b0f15-f7be-4821-9a73-152f2a710204" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map (flight) -> {
    ID: flight.ID,
    code: (flight.code1 default "") ++ (flight.code2 default ""),
    price: flight.price default 0,
    departureDate: flight.takeOffDate as String default "",
    origin: flight.fromAirport default "",
    destination: flight.toAirport default "",
    emptySeats: flight.seatsAvailable default 0,
    plane: {
        "type": flight.planeType default "",
        totalSeats: flight.totalSeats default 0
    }
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
	<flow name="getFlightById" doc:id="bdd3e4b2-1035-4336-a74b-ac1dcf8e1719">
		<set-variable value="#[attributes.uriParams.flightId]" doc:name="flightId" doc:id="755bb614-870d-432b-a946-12a0ae826cf0" variableName="flightId"/>
		<set-variable value='#[{ "status": "Get American Flight request"}]' doc:name="logMessage" doc:id="10887a46-aef7-4a2a-8017-7a885ab79b00" variableName="logMessage"/>
		<flow-ref doc:name="logAudit" doc:id="d84ecf7f-5cbe-46e3-a155-07cf61fca4fa" name="logAudit"/>
		<db:select doc:name="Select flight" doc:id="51772ea4-5009-4f9d-862a-b64df44d24fd" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT * FROM american
WHERE ID = :Id;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{ Id: vars.flightId }]]]></db:input-parameters>
		</db:select>
		<validation:is-not-empty-collection doc:name="Is not empty collection" doc:id="d638384b-f576-46f6-8306-8e211fc54b34" message='Flight with this ID not found.'>
			<error-mapping targetType="APP:FLIGHT_NOT_FOUND" />
		</validation:is-not-empty-collection>
		<set-variable value='#[{ "status": "Get flight from DB",&#10;	"fetchedRecords": sizeOf(payload)&#10;}]' doc:name="logMessage" doc:id="4003e5f3-21d5-43b0-b49b-5d5223fc9fac" variableName="logMessage" />
		<ee:transform doc:name="Transform Message" doc:id="35d315cc-125c-4087-a7bf-27c08b1a6d32" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map (flight) -> {
	ID: flight.ID,
	code: (flight.code1 default "") ++ (flight.code2 default ""),
	price: flight.price default 0,
	departureDate: flight.takeOffDate as String default "",
	origin: flight.fromAirport default "",
	destination: flight.toAirport default "",
	emptySeats: flight.seatsAvailable default 0,
	plane: {
		"type": flight.planeType default "",
		totalSeats: flight.totalSeats default 0
	}
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="44c3445f-3584-4b9b-a00c-631bfab7d39f" type="APP:FLIGHT_NOT_FOUND">
				<set-variable value="#[404 as Number]" doc:name="httpStatus" doc:id="b5da8635-9502-4dd3-ac06-6de7f7a8e26c" variableName="httpStatus" />
				<ee:transform doc:name="Transform Message" doc:id="7f90f7d4-7f3d-43da-b8b9-02f8d604c51b" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import modules::ErrorUtils 
---
ErrorUtils::getErrorStructure(
    {
        description: error.description
    },
    error.errorType.namespace ++ ":" ++ error.errorType.identifier
)]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="logError" doc:id="c7c84988-3460-4330-977b-8d8a3caea00b" name="logError"/>
			</on-error-continue>
		</error-handler>
    </flow>
	<sub-flow name="getCountryWeather" doc:id="5c4b03a0-403e-4417-8e42-e496ae5b8594" >
		<flow-ref doc:name="getCountries" doc:id="34178810-c05d-4b52-b5b8-5f05b839f26e" name="getCountries" />
		<ee:transform doc:name="Transform Message" doc:id="2449c74e-4f40-4e1b-a18a-4b581b262c87">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map $.name]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="getWeather" doc:id="7f2f46e8-2071-45d7-83a6-9e9c87cfaf55" name="getWeather" />
	</sub-flow>
	<sub-flow name="getCountries" doc:id="675702c2-2a78-41df-a609-1cd705da478f" >
		<ee:transform doc:name='Set and Encode variable "country"' doc:id="9df4bae6-3a3b-45b0-831e-91650b04877e">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="country"><![CDATA[%dw 2.0
import * from dw::core::URL
output application/java
---
encodeURIComponent(attributes.uriParams.countryName)]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request doc:name="REST Countries" doc:id="f24cb6e3-3fd3-4677-9b1d-bbfeea10d82f" config-ref="RESTCountries_Request_Config" path="/name/{country}">
			<http:uri-params><![CDATA[#[output application/java
---
{
	"country" : vars.country
}]]]></http:uri-params>
			<http:query-params><![CDATA[#[output application/java
---
{
	"fields" : "name,capital,capitalInfo"
}]]]></http:query-params>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="a691fe71-eb28-4cd9-a56f-fd1157127311">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map (country, index) -> {
    name: country.name.common,
    capital: {
        name: country.capital[0], 
        lat: country.capitalInfo.latlng[0],
        lng: country.capitalInfo.latlng[1]
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
	<sub-flow name="getWeather" doc:id="bc46af63-dff9-4ba0-b699-0b887cccc2fe" >
		<parallel-foreach doc:name="Parallel For Each" doc:id="ba67812c-e1df-4019-bb0b-683305603d2e">
			<http:request doc:name="Request" doc:id="4e2fb968-96ab-4a26-8243-90ad51884fbc" config-ref="OpenWeather_Request_Config" path="/weather">
						<http:query-params><![CDATA[#[output application/java
---
{
	"q" : payload
}]]]></http:query-params>
					</http:request>
		</parallel-foreach>
		<ee:transform doc:name="Transform Message" doc:id="116d7633-355b-4c5d-9daa-317e25ad31d6">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload.payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
