		<amqp:consume doc:name="Consume" doc:id="88301757-4455-4300-ae85-1785ceb803dd" config-ref="AMQP_Config" queueName="mulesoft-queue"/>
	</flow>
	<flow name="rabbitmq-hello-worldFlow" doc:id="0a58146e-92c1-45ac-968a-3ba8d195da75" >
		<http:listener doc:name="Listener" doc:id="d5dc56bb-26a8-4e8a-b8fb-bb52110d874e" config-ref="HTTP_Listener_config" path="/publishHello" allowedMethods="POST"/>
		<amqp:publish doc:name="Publish" doc:id="f9b59694-ac5f-413d-92ec-0201b3cf767f" config-ref="AMQP_Config">
			<amqp:routing-keys >
				<amqp:routing-key value="mulesoft-queue" />
